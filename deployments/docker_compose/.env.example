# Copy to .env and set every CHANGE_ME:  cp .env.example .env

# REQUIRED - set for your environment
API_SERVER_NAME=CHANGE_ME

# REQUIRED - set for your environment
OAUTH_CLIENT_ID=CHANGE_ME

# SECRET - set a strong value
OAUTH_CLIENT_SECRET=CHANGE_ME

# SECRET - set a strong value
OPENAI_API_KEY=CHANGE_ME

# REQUIRED - set for your environment
OPENID_REDIRECT_URI=CHANGE_ME

# SECRET - set a strong value
WEBUI_SECRET_KEY=CHANGE_ME
